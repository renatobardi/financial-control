# Só os nomes. O .env de verdade fica fora do git (root, modo 0600).
# Segredo que assina o cookie de sessão. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FINANCEIRO_SEGREDO=
# Commit exibido no /healthz (o compose preenche pelo build).
FINANCEIRO_COMMIT=
# Endereço publicado no host (padrão 127.0.0.1:8000, atrás do nginx).
FINANCEIRO_PUBLICAR=
# Só para desenvolvimento local sem TLS: 0 desliga o Secure do cookie.
FINANCEIRO_COOKIE_SEGURO=
